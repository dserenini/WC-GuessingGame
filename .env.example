# Supabase Configuration
# Rename this file to .env and place your production keys here.
# WARNING: Ensure .env is added to your .gitignore (it already is for Flutter).

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
MASTER_DATA_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_DOC_ID/pub?output=csv
